# ORACLE Environment Configuration

# Circle Developer API (https://developers.circle.com/w3s/docs)
# Get your sandbox API key at https://console.circle.com
CIRCLE_API_KEY=TEST_API_KEY:your-key-id:your-secret

# Circle entity secret — 32 random bytes, hex-encoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIRCLE_ENTITY_SECRET=your-32-byte-hex-entity-secret

# Circle wallet set ID (create one via API or console first)
CIRCLE_WALLET_SET_ID=your-wallet-set-id

# Arc testnet RPC (default: https://rpc.arc.canteen.xyz, fallback: https://arc-testnet.drpc.org)
ARC_RPC_URL=https://rpc.arc.canteen.xyz

# Optional: Redis URL for poly-scout signal caching (5-min TTL)
REDIS_URL=redis://localhost:6379

# Bankroll in USDC for Kelly criterion sizing (default: 100)
ORACLE_BANKROLL_USDC=100

# Kelly fraction multiplier (default: 0.5 = half-Kelly, conservative)
KELLY_MULTIPLIER=0.5

# Minimum edge to act on (default: 0.05 = 5% edge required)
MIN_EDGE=0.05

# Cron schedule (default: every 15 minutes)
CRON_SCHEDULE=*/15 * * * *
